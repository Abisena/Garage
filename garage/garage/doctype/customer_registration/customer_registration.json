{
  "doctype": "DocType",
  "name": "Customer Registration",
  "module": "Garage",
  "autoname": "format:CR-{#####}",
  "allow_import": 1,
  "track_changes": 1,
  "title_field": "license_plate",
  "description": "Quick customer and vehicle registration for service intake",

  "field_order": [
    "info_section",
    "branch",
    "intake_type",
    
    "vehicle_section",
    "license_plate",
    "column_break_v1",
    "brand",
    "model",
    
    "vehicle_info",
    "vehicle_type",
    "chassiss_bumber",
    "vehicle_year",
    "engine_number",
    "column_break_v2",
    "mileage",
    
    "complaint_section",
    "complaint",

    "customer_section",
    "customer_name",
    "phone",
    "column_break_c1",
    "email",
    "is_vip",

    "service_section",
    "service_order_type",
    "column_break_s1",
    "priority",
    
    "notes_section",
    "service_notes",

    "system_section",
    "vehicle",
    "customer",
    "column_break_sys",
    "service_order"
  ],

  "fields": [
    {
      "fieldname": "info_section",
      "fieldtype": "Section Break",
      "label": "📋 Basic Information"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Garage Branch",
      "in_list_view": 1,
      "reqd": 1,
      "description": "Which branch is handling this?"
    },
    {
      "fieldname": "intake_type",
      "fieldtype": "Select",
      "label": "Customer came by",
      "options": "Walk-In\nBooking",
      "default": "Walk-In",
      "in_list_view": 1,
      "description": "Did they walk in or book an appointment?"
    },
    
    {
      "fieldname": "vehicle_section",
      "fieldtype": "Section Break",
      "label": "🚗 Vehicle Details",
      "description": "Tell us about the vehicle"
    },
    {
      "fieldname": "license_plate",
      "fieldtype": "Data",
      "label": "License Plate",
      "in_list_view": 1,
      "in_global_search": 1,
      "bold": 1,
      "reqd": 1,
      "description": "e.g., B 1234 ABC"
    },
    {
      "fieldname": "column_break_v1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "brand",
      "fieldtype": "Link",
      "label": "Car Brand",
      "options": "Garage Brand",
      "in_standard_filter": 1,
      "description": "e.g., Toyota, Honda"
    },
    {
      "fieldname": "model",
      "fieldtype": "Link",
      "label": "Car Model",
      "options": "Garage Model",
      "description": "e.g., Avanza, Jazz"
    },
    
    {
      "fieldname": "vehicle_info",
      "fieldtype": "Section Break",
      "label": "Additional Vehicle Info",
      "collapsible": 1,
      "collapsible_depends_on": "eval:!doc.__islocal"
    },
    {
      "fieldname": "vehicle_type",
      "fieldtype": "Select",
      "label": "Vehicle Type",
      "options": "\nSedan\nHatchback\nSUV\nMPV\nTruck\nVan\nCoupe\nWagon",
      "description": "What type of vehicle?"
    },
    {
      "fieldname": "vehicle_year",
      "fieldtype": "Int",
      "label": "Year",
      "description": "What year was it made?"
    },
    {
      "fieldname": "chassiss_bumber",
      "fieldtype": "Int",
      "label": "Chassis Number"
    },
    {
      "fieldname": "engine_number",
      "fieldtype": "Int",
      "label": "Engine Number"
    },
    {
      "fieldname": "column_break_v2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "mileage",
      "fieldtype": "Int",
      "label": "Mileage (KM)",
      "description": "Current odometer reading"
    },
    
    {
      "fieldname": "complaint_section",
      "fieldtype": "Section Break",
      "label": "💬 What's the problem?"
    },
    {
      "fieldname": "complaint",
      "fieldtype": "Text Editor",
      "label": "Customer's Complaint",
      "description": "What issue is the customer experiencing? What service do they need?"
    },

    {
      "fieldname": "customer_section",
      "fieldtype": "Section Break",
      "label": "👤 Customer Information",
      "description": "Who owns this vehicle?"
    },
    {
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "label": "Customer Name",
      "in_list_view": 1,
      "in_global_search": 1,
      "bold": 1,
      "reqd": 1,
      "description": "Full name of the vehicle owner"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Phone Number",
      "options": "Phone",
      "in_list_view": 1,
      "reqd": 1,
      "description": "Primary contact number (required)"
    },
    {
      "fieldname": "column_break_c1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email (Optional)",
      "options": "Email",
      "description": "Customer's email address"
    },
    {
      "fieldname": "is_vip",
      "fieldtype": "Check",
      "label": "⭐ VIP Customer",
      "description": "Check if this is a VIP customer"
    },

    {
      "fieldname": "service_section",
      "fieldtype": "Section Break",
      "label": "🔧 Service Request",
      "description": "What service do they need?"
    },
    {
      "fieldname": "service_order_type",
      "fieldtype": "Link",
      "label": "Service Type",
      "options": "Garage Service Type",
      "in_list_view": 1,
      "bold": 1,
      "reqd": 1,
      "description": "What kind of service? (e.g., Oil Change, Repair)"
    },
    {
      "fieldname": "column_break_s1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "How urgent?",
      "options": "Normal\nHigh\nUrgent\nCritical",
      "default": "Normal",
      "in_list_view": 1,
      "description": "How quickly does this need to be done?"
    },
    
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "📝 Internal Notes (Optional)",
      "collapsible": 1
    },
    {
      "fieldname": "service_notes",
      "fieldtype": "Text Editor",
      "label": "Staff Notes",
      "description": "Internal notes for service advisors (customer won't see this)"
    },

    {
      "fieldname": "system_section",
      "fieldtype": "Section Break",
      "label": "🔗 System Records (Auto-Generated)",
      "collapsible": 1,
      "collapsible_depends_on": "eval:doc.vehicle || doc.customer || doc.service_order"
    },
    {
      "fieldname": "vehicle",
      "fieldtype": "Link",
      "label": "Vehicle Record",
      "options": "Garage Vehicle",
      "read_only": 1,
      "description": "Linked vehicle master record"
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer Record",
      "options": "Garage Customer",
      "read_only": 1,
      "description": "Linked customer master record"
    },
    {
      "fieldname": "column_break_sys",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "service_order",
      "fieldtype": "Link",
      "label": "Service Order",
      "options": "Garage Service Order",
      "read_only": 1,
      "description": "Generated service order"
    }
  ],

  "permissions": [
    {
      "role": "System Manager",
      "create": 1,
      "read": 1,
      "write": 1,
      "delete": 1,
      "email": 1,
      "print": 1,
      "share": 1,
      "export": 1
    },
    {
      "role": "Garage User",
      "create": 1,
      "read": 1,
      "write": 1,
      "email": 1,
      "print": 1,
      "share": 1
    }
  ],
  
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_seen": 1,
  "show_name_in_global_search": 1
}
