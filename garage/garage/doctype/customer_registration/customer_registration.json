{
  "doctype": "DocType",
  "name": "Customer Registration",
  "module": "Garage",
  "autoname": "format:CR-{#####}",
  "allow_import": 1,
  "track_changes": 1,
  "title_field": "license_plate",
  "description": "Quick customer and vehicle registration for service intake",

  "field_order": [
    "info_section",
    "branch",
    "intake_type",
    "registration_date",
    
    "customer_section",
    "customer_name",
    "phone",
    "column_break_c1",
    "email",
    "is_vip",
    
    "vehicle_section",
    "license_plate",
    "brand",
    "column_break_v1",
    "model",
    "mileage",
    
    "vehicle_details_section",
    "vehicle_type",
    "vehicle_year",
    "column_break_v2",
    "chassiss_bumber",
    "engine_number",
    
    "service_section",
    "service_order_type",
    "priority",
    "column_break_s1",
    "estimated_duration",
    "preferred_date",
    
    "complaint_section",
    "complaint",
    
    "notes_section",
    "service_notes",

    "system_section",
    "vehicle",
    "customer",
    "column_break_sys",
    "service_order"
  ],

  "fields": [
    {
      "fieldname": "info_section",
      "fieldtype": "Section Break",
      "label": "📋 Registration Info"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Garage Branch",
      "in_list_view": 1,
      "reqd": 1,
      "bold": 1,
      "description": "Select service branch"
    },
    {
      "fieldname": "intake_type",
      "fieldtype": "Select",
      "label": "Visit Type",
      "options": "Walk-In\nBooking",
      "default": "Walk-In",
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "registration_date",
      "fieldtype": "Datetime",
      "label": "Registration Time",
      "default": "now",
      "read_only": 1,
      "in_list_view": 1
    },
    
    {
      "fieldname": "customer_section",
      "fieldtype": "Section Break",
      "label": "👤 Customer Details",
      "description": "Customer contact information"
    },
    {
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "label": "Full Name",
      "in_list_view": 1,
      "in_global_search": 1,
      "bold": 1,
      "reqd": 1,
      "description": "Vehicle owner's full name"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Phone Number",
      "options": "Phone",
      "in_list_view": 1,
      "reqd": 1,
      "bold": 1,
      "description": "Primary contact (WhatsApp preferred)"
    },
    {
      "fieldname": "column_break_c1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email",
      "options": "Email",
      "description": "Optional - for invoice delivery"
    },
    {
      "fieldname": "is_vip",
      "fieldtype": "Check",
      "label": "⭐ VIP Customer",
      "description": "Special priority service"
    },

    {
      "fieldname": "vehicle_section",
      "fieldtype": "Section Break",
      "label": "🚗 Vehicle Information",
      "description": "Basic vehicle details (required)"
    },
    {
      "fieldname": "license_plate",
      "fieldtype": "Data",
      "label": "License Plate Number",
      "in_list_view": 1,
      "in_global_search": 1,
      "bold": 1,
      "reqd": 1,
      "description": "e.g., B 1234 ABC"
    },
    {
      "fieldname": "brand",
      "fieldtype": "Link",
      "label": "Brand",
      "options": "Garage Brand",
      "in_standard_filter": 1,
      "reqd": 1,
      "description": "e.g., Toyota, Honda, Suzuki"
    },
    {
      "fieldname": "column_break_v1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "model",
      "fieldtype": "Link",
      "label": "Model",
      "options": "Garage Model",
      "reqd": 1,
      "description": "e.g., Avanza, Jazz, Ertiga"
    },
    {
      "fieldname": "mileage",
      "fieldtype": "Int",
      "label": "Current Mileage (KM)",
      "bold": 1,
      "description": "Odometer reading"
    },
    
    {
      "fieldname": "vehicle_details_section",
      "fieldtype": "Section Break",
      "label": "Additional Vehicle Details",
      "collapsible": 1,
      "collapsible_depends_on": "eval:!doc.__islocal",
      "description": "Optional - fill if available"
    },
    {
      "fieldname": "vehicle_type",
      "fieldtype": "Select",
      "label": "Vehicle Type",
      "options": "\nSedan\nHatchback\nSUV\nMPV\nTruck\nVan\nCoupe\nWagon"
    },
    {
      "fieldname": "vehicle_year",
      "fieldtype": "Int",
      "label": "Manufacturing Year",
      "description": "e.g., 2020"
    },
    {
      "fieldname": "column_break_v2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "chassiss_bumber",
      "fieldtype": "Data",
      "label": "Chassis Number",
      "description": "17-digit VIN"
    },
    {
      "fieldname": "engine_number",
      "fieldtype": "Data",
      "label": "Engine Number"
    },
    
    {
      "fieldname": "service_section",
      "fieldtype": "Section Break",
      "label": "🔧 Service Request",
      "description": "What service is needed?"
    },
    {
      "fieldname": "service_order_type",
      "fieldtype": "Link",
      "label": "Service Type",
      "options": "Garage Service Type",
      "in_list_view": 1,
      "bold": 1,
      "reqd": 1,
      "description": "e.g., Oil Change, Tire Service, General Repair"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "Priority Level",
      "options": "Normal\nHigh\nUrgent\nCritical",
      "default": "Normal",
      "in_list_view": 1,
      "bold": 1,
      "description": "Service urgency"
    },
    {
      "fieldname": "column_break_s1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "estimated_duration",
      "fieldtype": "Select",
      "label": "Estimated Duration",
      "options": "\n30 Minutes\n1 Hour\n2 Hours\n3 Hours\n4+ Hours\nFull Day",
      "description": "Approximate service time"
    },
    {
      "fieldname": "preferred_date",
      "fieldtype": "Date",
      "label": "Preferred Service Date",
      "default": "Today",
      "description": "When should we service this?"
    },
    
    {
      "fieldname": "complaint_section",
      "fieldtype": "Section Break",
      "label": "💬 Customer Complaint / Service Notes",
      "description": "What's the problem? What does the customer need?"
    },
    {
      "fieldname": "complaint",
      "fieldtype": "Text Editor",
      "label": "Customer's Complaint",
      "description": "Describe the issue or service request in detail"
    },
    
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "📝 Internal Notes",
      "collapsible": 1,
      "description": "Staff notes (not visible to customer)"
    },
    {
      "fieldname": "service_notes",
      "fieldtype": "Text Editor",
      "label": "Internal Notes",
      "description": "Additional observations, special instructions, or reminders"
    },

    {
      "fieldname": "system_section",
      "fieldtype": "Section Break",
      "label": "🔗 System Links",
      "collapsible": 1,
      "collapsible_depends_on": "eval:doc.vehicle || doc.customer || doc.service_order",
      "description": "Auto-generated records"
    },
    {
      "fieldname": "vehicle",
      "fieldtype": "Link",
      "label": "Vehicle Master",
      "options": "Garage Vehicle",
      "read_only": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer Master",
      "options": "Garage Customer",
      "read_only": 1
    },
    {
      "fieldname": "column_break_sys",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "service_order",
      "fieldtype": "Link",
      "label": "Service Order",
      "options": "Garage Service Order",
      "read_only": 1
    }
  ],

  "permissions": [
    {
      "role": "System Manager",
      "create": 1,
      "read": 1,
      "write": 1,
      "delete": 1,
      "email": 1,
      "print": 1,
      "share": 1,
      "export": 1
    },
    {
      "role": "Garage User",
      "create": 1,
      "read": 1,
      "write": 1,
      "email": 1,
      "print": 1,
      "share": 1
    },
    {
      "role": "Garage Receptionist",
      "create": 1,
      "read": 1,
      "write": 1,
      "print": 1
    }
  ],
  
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_seen": 1,
  "show_name_in_global_search": 1,
  "quick_entry": 1,
  "is_submittable": 0
}
